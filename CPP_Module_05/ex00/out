    std::cout << "done!\n";
    return (0);
}
NAME = bureaucrat

FLAGS = -Wall -Wextra -Werror -std=c++98 -fsanitize=address

SRCS = Bureaucrat.cpp main.cpp

HEADERS = Bureaucrat.hpp

OBJS = $(SRCS:.cpp=.o)

all: $(NAME)

%.o: %.cpp $(HEADERS)
	c++ $(FLAGS) -c $< -o $@

$(NAME): $(OBJS)
	c++ $(FLAGS) $^ -o $@

clean:
	rm -f $(OBJS)

fclean: clean
	rm -f $(NAME)

re: fclean all

.PHONY: clean fclean re